{
	"name": "root-utilities",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"clean": "node scripts/clean.mjs",
		"clean:full": "node scripts/clean-full.mjs",
		"lint": "eslint packages --ext mjs,js,ts,tsx --fix",
		"format": "prettier --write \"packages/**/{src,tests,scripts}/**/*.{mjs,ts,js}\"",
		"test": "vitest run",
		"build": "yarn workspace @sapphire/node-utilities build && yarn workspaces foreach --all --exclude root-utilities run build",
		"build:check-subpath": "yarn workspaces foreach --all --exclude root-utilities run build:check-subpath",
		"update": "yarn upgrade-interactive",
		"check-update": "yarn workspaces foreach --all --exclude root-utilities run check-update",
		"gen-index": "yarn workspaces foreach --all --exclude root-utilities run gen-index",
		"au:twemojis": "unrun ./scripts/twemoji-regex-updater.ts"
	},
	"devDependencies": {
		"@babel/parser": "^8.0.8",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@favware/cliff-jumper": "^6.1.0",
		"@favware/npm-deprecate": "^2.0.0",
		"@sapphire/framework": "^5.5.1",
		"@types/lodash": "^4.17.27",
		"@types/node": "^24.19.2",
		"@types/ws": "^8.18.2",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"@vitest/coverage-v8": "^5.0.5",
		"colorette": "^2.0.20",
		"cz-conventional-changelog": "^3.3.0",
		"discord.js": "^14.27.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"lint-staged": "^17.6.0",
		"lodash": "^4.18.1",
		"msw": "^3.0.3",
		"prettier": "^3.9.10",
		"rimraf": "^6.1.3",
		"tsdown": "^0.23.3",
		"typescript": "~6.0.3",
		"undici": "^8.12.3",
		"unrun": "^0.3.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sapphiredev/utilities.git"
	},
	"engines": {
		"node": ">=v24.0.0",
		"npm": ">=12.0.0"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write",
		"*.{mjs,js,ts}": "eslint --fix --ext mjs,js,ts"
	},
	"packageManager": "yarn@4.18.1",
	"type": "module"
}
