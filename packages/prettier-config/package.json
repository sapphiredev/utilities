		"prepack": "yarn build",
		"bump": "cliff-jumper",
		"check-update": "cliff-jumper --dry-run"
	},
	"dependencies": {
		"prettier": "^3.9.10"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sapphiredev/utilities.git",
		"directory": "packages/prettier-config"
	},
	"files": [
		"dist/"
	],
	"engines": {
		"node": ">=v24.0.0",
		"npm": ">=12.0.0"
	},
	"keywords": [
		"sapphiredev",
		"bot",
		"typescript",
		"ts",
		"yarn",
		"discord",
		"sapphire",
		"standalone"
	],
	"bugs": {
		"url": "https://github.com/sapphiredev/utilities/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@favware/cliff-jumper": "^6.1.0",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.13.0",
		"tsdown": "0.23.1",
		"typescript": "~6.0.3",
		"unrun": "^0.3.1",
		"vitest": "^5.0.5"
	}
}
