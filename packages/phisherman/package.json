{
	"name": "@sapphire/phisherman",
	"version": "2.0.1",
	"description": "Wrapper around phisherman to easily check and report domains",
	"author": "@sapphire",
	"license": "MIT",
	"main": "dist/index.mjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		"types": "./dist/index.d.mts",
		"default": "./dist/index.mjs"
	},
	"homepage": "https://github.com/sapphiredev/utilities/tree/main/packages/phisherman",
	"scripts": {
		"lint": "eslint src --ext ts --fix",
		"build": "yarn gen-index && tsdown",
		"prepack": "yarn build",
		"bump": "cliff-jumper",
		"check-update": "cliff-jumper --dry-run",
		"gen-index": "unrun ../../scripts/gen-index.ts phisherman --write"
	},
	"dependencies": {
		"@sapphire/fetch": "workspace:^"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sapphiredev/utilities.git",
		"directory": "packages/phisherman"
	},
	"files": [
		"dist/"
	],
	"engines": {
		"node": ">=18"
	},
	"keywords": [
		"sapphiredev",
		"bot",
		"typescript",
		"ts",
		"yarn",
		"discord",
		"sapphire",
		"phisherman",
		"scam",
		"detection"
	],
	"bugs": {
		"url": "https://github.com/sapphiredev/utilities/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@favware/cliff-jumper": "^6.1.0",
		"@sapphire/result": "workspace:^",
		"tsdown": "0.23.1",
		"typescript": "~6.0.3",
		"unplugin-replace": "^0.9.1",
		"unrun": "^0.3.1"
	},
	"type": "module"
}
