{
	"name": "@sapphire/discord.js-utilities",
	"version": "7.3.3",
	"description": "Discord.js specific utilities for your JavaScript/TypeScript bots",
	"author": "@sapphire",
	"license": "MIT",
	"main": "dist/index.mjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		"types": "./dist/index.d.mts",
		"default": "./dist/index.mjs"
	},
	"sideEffects": false,
	"homepage": "https://github.com/sapphiredev/utilities/tree/main/packages/discord.js-utilities",
	"scripts": {
		"lint": "eslint src --ext ts --fix",
		"build": "yarn gen-index && tsdown",
		"prepack": "yarn build",
		"bump": "cliff-jumper",
		"check-update": "cliff-jumper --dry-run",
		"gen-index": "unrun ../../scripts/gen-index.ts discord.js-utilities --write"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sapphiredev/utilities.git",
		"directory": "packages/discord.js-utilities"
	},
	"files": [
		"dist/"
	],
	"engines": {
		"node": ">=16.6.0",
		"npm": ">=12.0.0"
	},
	"keywords": [
		"@sapphire/discord.js-utilities",
		"bot",
		"typescript",
		"ts",
		"yarn",
		"discord",
		"sapphire",
		"standalone",
		"discord.js"
	],
	"bugs": {
		"url": "https://github.com/sapphiredev/utilities/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@sapphire/discord-utilities": "workspace:^",
		"@sapphire/duration": "workspace:^",
		"@sapphire/utilities": "workspace:^"
	},
	"devDependencies": {
		"@favware/cliff-jumper": "^6.1.0",
		"eslint": "^10.13.0",
		"tsdown": "0.23.1",
		"typescript": "~6.0.3",
		"unrun": "^0.3.1"
	},
	"type": "module"
}
