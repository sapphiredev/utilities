{
	"name": "@sapphire/bitfield",
	"version": "1.2.4",
	"description": "A bitfield utility library for JavaScript.",
	"author": "@sapphire",
	"license": "MIT",
	"main": "dist/index.mjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		"types": "./dist/index.d.mts",
		"default": "./dist/index.mjs"
	},
	"sideEffects": false,
	"homepage": "https://github.com/sapphiredev/utilities/tree/main/packages/bitfield",
	"scripts": {
		"test": "vitest run",
		"lint": "eslint src tests --ext ts --fix",
		"build": "yarn gen-index && tsdown",
		"prepack": "yarn build",
		"bump": "cliff-jumper",
		"check-update": "cliff-jumper --dry-run",
		"gen-index": "unrun ../../scripts/gen-index.ts bitfield --write"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sapphiredev/utilities.git",
		"directory": "packages/bitfield"
	},
	"files": [
		"dist/"
	],
	"engines": {
		"node": ">=v24.0.0",
		"npm": ">=12.0.0"
	},
	"keywords": [
		"@sapphire/bitfield",
		"bitfield",
		"bot",
		"typescript",
		"ts",
		"yarn",
		"discord",
		"sapphire",
		"standalone"
	],
	"bugs": {
		"url": "https://github.com/sapphiredev/utilities/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@favware/cliff-jumper": "^6.1.0",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.13.0",
		"tsdown": "^0.23.3",
		"typescript": "~6.0.3",
		"unrun": "^0.3.1",
		"vitest": "^5.0.5"
	},
	"type": "module"
}
